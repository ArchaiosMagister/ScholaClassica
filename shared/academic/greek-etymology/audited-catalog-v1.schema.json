{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo Etymologicon Griego I conciliado con auditoría docente",
  "type": "object",
  "required": [
    "schema",
    "course",
    "status",
    "correctionPolicy",
    "etymons",
    "derivatives",
    "relations",
    "excluded",
    "editorialDecisions",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "etymologicon-audited-catalog/v1"
    },
    "course": {
      "const": "gr1"
    },
    "status": {
      "const": "editorially_reconciled_not_published"
    },
    "etymons": {
      "type": "array",
      "minItems": 111,
      "maxItems": 111,
      "items": {
        "type": "object",
        "required": [
          "id",
          "lemma",
          "editorialStatus",
          "teacherApprovedDerivatives",
          "units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^grc:"
          },
          "lemma": {
            "type": "string",
            "minLength": 1
          },
          "editorialStatus": {
            "enum": [
              "approved_for_documented_derivatives",
              "reference_only"
            ]
          },
          "teacherApprovedDerivatives": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^es:"
            }
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^UD\\d+$"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "derivatives": {
      "type": "array",
      "minItems": 201,
      "maxItems": 201,
      "items": {
        "type": "object",
        "required": [
          "id",
          "form",
          "definitions",
          "officialOrthographicVariants",
          "lexicalSource"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^es:"
          },
          "form": {
            "type": "string",
            "minLength": 1
          },
          "definitions": {
            "type": "array",
            "minItems": 1
          },
          "officialOrthographicVariants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lexicalSource": {
            "type": "object",
            "required": [
              "url",
              "checkedIndependently"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "checkedIndependently": {
                "const": false
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "minItems": 217,
      "maxItems": 217
    },
    "excluded": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1
    },
    "editorialDecisions": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22
    },
    "correctionPolicy": {
      "type": "object",
      "required": [
        "correctDerivative",
        "unambiguousOrthographicError",
        "incorrectOrUncatalogued"
      ],
      "properties": {
        "correctDerivative": {
          "const": 1
        },
        "unambiguousOrthographicError": {
          "const": 0.5
        },
        "incorrectOrUncatalogued": {
          "const": 0
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "greek2": {
      "type": "object"
    },
    "caution": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
