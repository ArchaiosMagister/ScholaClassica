{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArchaiosMagister/ScholaClassica/blob/main/shared/academic/greek-etymology/model-v1.schema.json",
  "title": "Etymologicon — modelo académico v1",
  "description": "Contrato de fichas aprobables. Las importaciones candidatas no se consideran verificadas y no habilitan ejercicios evaluables.",
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": [
        "id",
        "sourceType",
        "locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceType": {
          "enum": [
            "academic",
            "official_dictionary",
            "specialized_dictionary",
            "teacher",
            "source_snapshot"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "etymon": {
      "type": "object",
      "required": [
        "id",
        "lemma",
        "meaning",
        "orthographicVariants",
        "components",
        "verificationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^grc:"
        },
        "lemma": {
          "type": "string",
          "minLength": 1
        },
        "meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "orthographicVariants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "verified_restricted",
            "pending_review",
            "excluded"
          ]
        },
        "reviewedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "derivative": {
      "type": "object",
      "required": [
        "id",
        "form",
        "definitions",
        "officialOrthographicVariants",
        "verificationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^es:"
        },
        "form": {
          "type": "string",
          "minLength": 1
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "sources",
              "verified"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/sourceRef"
                }
              },
              "verified": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "officialOrthographicVariants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "verified_restricted",
            "pending_review",
            "excluded"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "etymonId",
        "derivativeId",
        "relationType",
        "verificationStatus",
        "eligibleFor",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "etymonId": {
          "type": "string",
          "pattern": "^grc:"
        },
        "derivativeId": {
          "type": "string",
          "pattern": "^es:"
        },
        "relationType": {
          "enum": [
            "direct",
            "indirect",
            "undetermined"
          ]
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "verified_restricted",
            "pending_review",
            "excluded"
          ]
        },
        "eligibleFor": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "cards",
              "match",
              "multiple_choice",
              "write_two",
              "inverse",
              "decompose",
              "meaning",
              "exam"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "course": {
      "type": "object",
      "required": [
        "course",
        "status",
        "units"
      ],
      "properties": {
        "course": {
          "enum": [
            "gr1",
            "gr2"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "pending_academic_audit",
            "awaiting_teacher_inventory"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "unit",
              "etymonIds"
            ],
            "properties": {
              "unit": {
                "type": "string",
                "pattern": "^UD[0-9]+$"
              },
              "etymonIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^grc:"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "required": [
        "schemaVersion",
        "etymons",
        "derivatives",
        "relations",
        "courses"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "etymons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/etymon"
          }
        },
        "derivatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derivative"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "courses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/course"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
